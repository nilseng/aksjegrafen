  "compilerOptions": {
    "downlevelIteration": true,
    "sourceMap": false,
    "outDir": "dist",
    "strict": true,
    "lib": ["esnext", "DOM"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "target": "ES5"
